# PostgreSQL ulanishi (Neon, Supabase yoki o'z serveringiz). Bo'sh qolsa lokal PGlite ishlatiladi.
DATABASE_URL=
# Shu email bilan ro'yxatdan o'tgan foydalanuvchi admin bo'ladi.
ADMIN_EMAIL=
# Admin panelning maxfiy manzili (oddiy /admin yopiladi). Taxmin qilib bo'lmaydigan satr qo'ying,
# masalan: openssl rand -hex 8  ->  ADMIN_PATH=qwert-3f9a1c7e5b2d4a60  ->  https://domen.uz/qwert-3f9a1c7e5b2d4a60
ADMIN_PATH=
# Yoki alohida subdomen: ADMIN_HOST=qwert.domen.uz (DNS'da shu subdomen saytga yo'naltiriladi)
# va kirish ikkala manzilda amal qilishi uchun COOKIE_DOMAIN=.domen.uz
ADMIN_HOST=
COOKIE_DOMAIN=
# /api/cron ni chaqirish uchun maxfiy kalit (uzun tasodifiy satr).
CRON_SECRET=
# USDT qabul qilinadigan hamyon manzillari. Faqat to'ldirilgan tarmoqlar kabinetda ko'rinadi.
USDT_TRC20_ADDRESS=
USDT_BEP20_ADDRESS=
USDT_ERC20_ADDRESS=
# Robot ishlaydigan bozorlar (standart: hammasi). Masalan faqat oltin: ROBOT_MARKETS=gold
ROBOT_MARKETS=gold,forex
# Mijozlarga ochiq bozorlar. ROBOT_MARKETS dagi qolganlari faqat admin, Telegram va demo hisobda (reyting C).
PUBLIC_CATEGORIES=gold
# Vercel'da loyihaning o'z Environment Variables sahifasiga qo'shing (yoki Team o'zgaruvchisini "Link Shared Variable" bilan ulang).
# Oltin uchun MAJBURIY: spot XAU/USD narxi (twelvedata.com, bepul tarif yetadi: robot har aylanishda 1 so'rov).
# Kalitsiz Yahoo'dagi GC=F fyuchersi olinadi, u spotdan bir necha o'n dollar farq qiladi.
TWELVEDATA_API_KEY=
# AI operator: deepseek yoki anthropic. Tegishli kalitni kiriting.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Ixtiyoriy: modelni almashtirish (standart: deepseek-chat yoki claude-haiku-5-5).
LLM_MODEL=
# Operator to'lov muammolarida yo'naltiradigan aloqa, masalan Telegram @username.
SUPPORT_CONTACT=
# O'z serveringizda robot 24 soat o'zi ishlashi uchun 1 qiling (Vercel'da emas).
ROBOT_SELF_SCHEDULE=0
ROBOT_INTERVAL_MIN=5
# Admin Telegram xabarlari: @BotFather dan bot token, @userinfobot dan chat id (bir nechta bo'lsa vergul bilan)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Email tasdiqlash kodi yuborish: resend | brevo | smtp (lokalda console — kod server jurnaliga yoziladi).
MAIL_PROVIDER=resend
# Jo'natuvchi. Resend/Brevo'da tasdiqlangan domen yoki manzil bo'lishi shart.
MAIL_FROM="Signal Desk <noreply@sizning-domen.uz>"
RESEND_API_KEY=
BREVO_API_KEY=
# SMTP (masalan Gmail: smtp.gmail.com, 465, ilova paroli bilan).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Robot demo hisobi (virtual, haqiqiy pul emas): boshlang'ich balans, savdoga risk %, komissiya %, qaysi reytinglar savdo qilinadi.
DEMO_START_BALANCE=10000
DEMO_RISK_PCT=1
DEMO_LEVERAGE=1000
DEMO_FEE_CRYPTO_PCT=0.04
DEMO_FEE_FX_PCT=0.005
DEMO_RATINGS=A,B,C
# Robot: savdo xarajati (komissiya/spred) riskning shu ulushidan oshsa signal berilmaydi. 0 = filtr o'chiq.
ROBOT_MAX_FEE_R=0.05

# Gerakl (skalping roboti) signallarini mijozlarga ochish. Berilmasa faqat admin, Telegram va demo hisob.
# GERAKL_PUBLIC=1
